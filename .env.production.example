# Copy to /etc/drawdb/production.env and set real values with mode 0600.
DRAWDB_IMAGE=ghcr.io/rename343/drawdb-collaborative-with-auth
DRAWDB_TAG=production
APP_DOMAIN=draw.example.com
DATA_DIR=/srv/drawdb/data
CADDY_DATA_DIR=/srv/drawdb/caddy-data
CADDY_CONFIG_DIR=/srv/drawdb/caddy-config
SSH_KEY_DIR=/etc/drawdb/ssh
BOOTSTRAP_SECRET=
# Optional. Leave empty unless configured at first git-sync setup.
GIT_SECRET_KEY=
